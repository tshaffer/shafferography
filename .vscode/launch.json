{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug shafferography",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/backend/src/server.ts",
      "preLaunchTask": "tsc: build - backend",
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ],
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register/transpile-only"
      ],
      "envFile": "${workspaceFolder}/backend/.env",
      "runtimeExecutable": "node",
      "sourceMaps": true
    },
    {
      "name": "Dry run generateMediaItemsByUniqueId (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/backend/src/scripts/generateMediaItemsByUniqueId.ts",
      "args": [
        "/Users/tedshaffer/Documents/tmpFiles/shafferography/photoDetails/mediaItemsByUniqueId.json",
        "--dryRun"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "sourceMaps": true
    },
    {
      "name": "Dry run populateMediaItemsFromLocalFiles (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/backend/src/scripts/populateMediaItemsFromLocalFiles.ts",
      "args": [
        "/Users/tedshaffer/Documents/tmpFiles/shafferography/photoDetails/mediaItemsByUniqueId.json",
        "--dryRun"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "sourceMaps": true
    }
  ]
}