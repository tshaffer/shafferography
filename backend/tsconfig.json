{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2020",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@types/*": ["src/types/*"],
      "@shared/types/*": ["../shared/types/*"]
    },
    "lib": ["es2015", "dom"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
